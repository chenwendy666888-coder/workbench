# 复制为 .env.local（本地）或填到 Vercel 项目 Environment Variables
# 天气 / RSS 源无需密钥；只有 AI 聊天与摘要需要

DASHSCOPE_API_KEY=
# 阿里云百炼兼容模式地址（含 /compatible-mode/v1）；如需覆盖再填 CHAT_API_BASE
# CHAT_API_BASE=https://ws-d1w7lv3jt8l5ysaq.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# CHAT_MODEL=qwen-plus

# 可选：默认资讯源（逗号分隔），前端不传 sources 时使用
DEFAULT_FEEDS=
